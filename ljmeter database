            if (!query) return;

            const chatLog = document.getElementById('chat-log');

            chatLog.innerHTML += `
                <div class="flex items-start justify-end space-x-3 space-x-reverse">
                    <div class="bg-cyan-600 p-3.5 rounded-2xl rounded-tr-none text-white text-xs leading-relaxed max-w-[85%] shadow-sm">

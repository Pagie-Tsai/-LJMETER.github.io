                </div>
            `;
            input.value = '';
            chatLog.scrollTop = chatLog.scrollHeight;

            const qLower = query.toLowerCase();
            const matched = records.filter(r => {
                const mode = (r.mode || '').toLowerCase();
                const cause = (r.cause || '').toLowerCase();
                const process = (r.process || '').toLowerCase();
                const effect = (r.effect || '').toLowerCase();
                return mode.includes(qLower) || cause.includes(qLower) || process.includes(qLower) || effect.includes(qLower);
            });

            let reply = `針對您的提問「<span class="text-cyan-300 font-semibold">${query}</span>」，俐準資料庫檢索結果如下：<br><br>`;

